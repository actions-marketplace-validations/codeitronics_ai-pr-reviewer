<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}} · AI PR Reviewer</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='4' fill='%23201e1d'/%3E%3Ctext x='16' y='22' font-family='Georgia' font-size='17' fill='%23f3f2f2' text-anchor='middle'%3Er%3C/text%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="{{root}}/static/app.css?v={{assetVersion}}">
  <script src="{{root}}/static/app.js?v={{assetVersion}}" defer></script>
</head>
<body>
  {{#if demo}}
  <div class="demo-bar"><span><strong>Demo</strong> · a recorded review of a real pull request · run it on your own PRs: <code>npx @codeitronics/ai-pr-reviewer ui</code> or add the GitHub Action</span></div>
  {{/if}}
  <header class="top">
    <a href="{{root}}/" class="brand">AI PR Reviewer</a>
    <nav>
      <a href="{{root}}/" class="{{#if (eq nav 'review')}}on{{/if}}">{{#if demo}}Sample review{{else}}Review{{/if}}</a>
      <a href="{{root}}/history" class="{{#if (eq nav 'history')}}on{{/if}}">History</a>
      <a href="https://github.com/codeitronics/ai-pr-reviewer#use-it-as-a-github-action" target="_blank" rel="noopener">Add to GitHub</a>
    </nav>
  </header>
  <main>{{{body}}}</main>
  <footer class="foot">AI PR Reviewer · open source by <a href="https://codeitronics.com" target="_blank" rel="noopener">CodeITronics</a> · <a href="https://github.com/codeitronics/ai-pr-reviewer" target="_blank" rel="noopener">GitHub</a> · AI can be wrong: treat reviews as a second pair of eyes</footer>
</body>
</html>
